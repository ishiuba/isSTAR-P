<script>
  document.title = titulo + " - YouTube";
</script>

<div class="streaming">
  <div class="cabecalho-streaming">
    <h1>YOUTUBE</h1>
  </div>

  <div class="conteudo-streaming">
    <div class="links-playlist">
      <a class="btn" href="https://iswebejs.vercel.app/streaming">
        <i class="fas fa-angle-left"></i>Streaming
      </a>
      <a class="btn" href="/spotify">
        <i class="fab fa-spotify"></i>Spotify
      </a>
    </div>

    <div class="busca-container">
      <div class="busca-input-container">
        <i class="fas fa-search icone-busca"></i>
        <input type="text" id="youtubeSearch" placeholder="Buscar playlists..." />
      </div>
    </div>

    <% if (typeof error !== 'undefined') { %>
    <div class="mensagem-erro">
      <i class="fas fa-exclamation-triangle"></i>
      <p><%= error %></p>
    </div>
    <% } %>

    <% if (typeof playlists !== 'undefined' && playlists.length > 0) { %>
    <div class="container-streaming" id="playlistsContainer">
      <!-- Conteúdo será carregado via JavaScript -->
    </div>

    <div class="paginacao-container">
      <button class="botao-paginacao" id="anteriorBtn" disabled>
        <i class="fas fa-chevron-left"></i>
      </button>
      <span class="info-paginacao">
        Página <span id="paginaAtual">1</span> de <span id="totalPaginas">1</span>
      </span>
      <button class="botao-paginacao" id="proximoBtn">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
    <% } else if (typeof playlists !== 'undefined') { %>
    <div class="sem-resultados">
      <p>Nenhuma playlist encontrada.</p>
    </div>
    <% } %>
  </div>
</div>

<script>
  // Dados das playlists
  const playlists = <%- JSON.stringify(playlists || []) %>;
  const itensPorPagina = 6;
  let paginaAtual = 1;
  let playlistsFiltradas = playlists;

  function renderizarPlaylists() {
    const container = document.getElementById('playlistsContainer');
    const inicio = (paginaAtual - 1) * itensPorPagina;
    const fim = inicio + itensPorPagina;
    const playlistsPagina = playlistsFiltradas.slice(inicio, fim);

    container.innerHTML = playlistsPagina.map(playlist => `
      <div class="item-playlist playlist-youtube">
        <div class="container-video">
          <div class="placeholder" data-src-embed="https://www.youtube.com/embed/videoseries?list=${playlist.id}" data-titulo="${playlist.snippet.title}">
            <div class="conteudo-placeholder youtube">
              <i class="fab fa-youtube icone-placeholder"></i>
              <p>Clique para reproduzir a playlist</p>
              <button class="botao-carregar-video">
                <i class="fas fa-play"></i> Reproduzir
              </button>
            </div>
          </div>
        </div>
        <div class="info-playlist">
          <h3 class="titulo-playlist">${playlist.snippet.title}</h3>
          <p class="descricao-playlist">${playlist.snippet.description ? playlist.snippet.description.substring(0, 100) + '...' : 'Sem descrição'}</p>
          <p class="contagem-playlist">${playlist.contentDetails.itemCount} vídeos</p>
        </div>
      </div>
    `).join('');

    atualizarPaginacao();
  }

  function atualizarPaginacao() {
    const totalPaginas = Math.ceil(playlistsFiltradas.length / itensPorPagina);
    document.getElementById('paginaAtual').textContent = paginaAtual;
    document.getElementById('totalPaginas').textContent = totalPaginas;
    
    document.getElementById('anteriorBtn').disabled = paginaAtual === 1;
    document.getElementById('proximoBtn').disabled = paginaAtual === totalPaginas;
  }

  function filtrarPlaylists(termo) {
    playlistsFiltradas = playlists.filter(playlist => 
      playlist.snippet.title.toLowerCase().includes(termo.toLowerCase()) ||
      (playlist.snippet.description && playlist.snippet.description.toLowerCase().includes(termo.toLowerCase()))
    );
    paginaAtual = 1;
    renderizarPlaylists();
  }

  // Event listeners
  document.getElementById('youtubeSearch').addEventListener('input', (e) => {
    filtrarPlaylists(e.target.value);
  });

  document.getElementById('anteriorBtn').addEventListener('click', () => {
    if (paginaAtual > 1) {
      paginaAtual--;
      renderizarPlaylists();
    }
  });

  document.getElementById('proximoBtn').addEventListener('click', () => {
    const totalPaginas = Math.ceil(playlistsFiltradas.length / itensPorPagina);
    if (paginaAtual < totalPaginas) {
      paginaAtual++;
      renderizarPlaylists();
    }
  });

  // Renderização inicial
  if (playlists.length > 0) {
    renderizarPlaylists();
  }
</script>
