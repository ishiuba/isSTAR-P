<script>
  document.title = titulo + " - Spotify";
</script>

<div class="streaming">
  <div class="cabecalho-streaming">
    <h1>SPOTIFY</h1>
  </div>

  <div class="conteudo-streaming">
    <div class="links-playlist">
      <a class="btn" href="https://iswebejs.vercel.app/streaming">
        <i class="fas fa-angle-left"></i>Streaming
      </a>
      <a class="btn" href="/youtube">
        <i class="fab fa-youtube"></i>YouTube
      </a>
    </div>

    <div class="busca-container">
      <div class="busca-input-container">
        <i class="fas fa-search icone-busca"></i>
        <input type="text" id="spotifySearch" placeholder="Buscar álbuns..." />
      </div>
    </div>

    <% if (typeof error !== 'undefined') { %>
    <div class="mensagem-erro">
      <i class="fas fa-exclamation-triangle"></i>
      <p><%= error %></p>
    </div>
    <% } %>

    <% if (typeof albums !== 'undefined' && albums.length > 0) { %>
    <div class="container-streaming" id="albumsContainer">
      <!-- Conteúdo será carregado via JavaScript -->
    </div>

    <div class="paginacao-container">
      <button class="botao-paginacao" id="anteriorBtn" disabled>
        <i class="fas fa-chevron-left"></i>
      </button>
      <span class="info-paginacao">
        Página <span id="paginaAtual">1</span> de <span id="totalPaginas">1</span>
      </span>
      <button class="botao-paginacao" id="proximoBtn">
        <i class="fas fa-chevron-right"></i>
      </button>
    </div>
    <% } else if (typeof albums !== 'undefined') { %>
    <div class="sem-resultados">
      <p>Nenhum álbum encontrado.</p>
    </div>
    <% } %>
  </div>
</div>

<script>
  // Dados dos álbuns
  const albums = <%- JSON.stringify(albums || []) %>;
  const itensPorPagina = 6;
  let paginaAtual = 1;
  let albumsFiltrados = albums;

  function renderizarAlbums() {
    const container = document.getElementById('albumsContainer');
    const inicio = (paginaAtual - 1) * itensPorPagina;
    const fim = inicio + itensPorPagina;
    const albumsPagina = albumsFiltrados.slice(inicio, fim);

    container.innerHTML = albumsPagina.map(album => `
      <div class="item-playlist playlist-spotify">
        <div class="container-video">
          <div class="placeholder" data-src-embed="https://open.spotify.com/embed/album/${album.id}?utm_source=generator">
            <div class="conteudo-placeholder spotify">
              <i class="fab fa-spotify icone-placeholder"></i>
              <p>Clique para reproduzir o álbum</p>
              <button class="botao-carregar-video">
                <i class="fas fa-play"></i> Reproduzir
              </button>
            </div>
          </div>
        </div>
        <div class="info-playlist">
          <h3 class="titulo-playlist">${album.name}</h3>
          <p class="artista-playlist">${album.artists.map(a => a.name).join(', ')}</p>
          <p class="data-playlist">${new Date(album.release_date).getFullYear()}</p>
        </div>
      </div>
    `).join('');

    atualizarPaginacao();
  }

  function atualizarPaginacao() {
    const totalPaginas = Math.ceil(albumsFiltrados.length / itensPorPagina);
    document.getElementById('paginaAtual').textContent = paginaAtual;
    document.getElementById('totalPaginas').textContent = totalPaginas;
    
    document.getElementById('anteriorBtn').disabled = paginaAtual === 1;
    document.getElementById('proximoBtn').disabled = paginaAtual === totalPaginas;
  }

  function filtrarAlbums(termo) {
    albumsFiltrados = albums.filter(album => 
      album.name.toLowerCase().includes(termo.toLowerCase()) ||
      album.artists.some(artist => artist.name.toLowerCase().includes(termo.toLowerCase()))
    );
    paginaAtual = 1;
    renderizarAlbums();
  }

  // Event listeners
  document.getElementById('spotifySearch').addEventListener('input', (e) => {
    filtrarAlbums(e.target.value);
  });

  document.getElementById('anteriorBtn').addEventListener('click', () => {
    if (paginaAtual > 1) {
      paginaAtual--;
      renderizarAlbums();
    }
  });

  document.getElementById('proximoBtn').addEventListener('click', () => {
    const totalPaginas = Math.ceil(albumsFiltrados.length / itensPorPagina);
    if (paginaAtual < totalPaginas) {
      paginaAtual++;
      renderizarAlbums();
    }
  });

  // Renderização inicial
  if (albums.length > 0) {
    renderizarAlbums();
  }
</script>
